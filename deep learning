        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Generate sample dataset (200 patients)\n",
        "np.random.seed(42)\n",
        "data = pd.DataFrame({\n",
        "    'Haemoglobin': np.random.normal(13, 2, 200),\n",
        "    'RBC': np.random.normal(5, 0.8, 200),\n",
        "    'Glucose': np.random.normal(100, 15, 200),\n",
        "    'Cholesterol': np.random.normal(190, 25, 200),\n",
        "    'BMI': np.random.normal(25, 4, 200)\n",
        "})\n",
        "\n",
        "# 1. Standardisation\n",
        "X = (data - data.mean()) / data.std()\n",
        "\n",
        "# 2. Covariance and Correlation\n",
        "cov = X.cov()\n",
        "corr = X.corr()\n",
        "\n",
        "plt.figure(figsize=(6,4))\n",
        "sns.heatmap(cov, annot=True, cmap='coolwarm')\n",
        "plt.title(\"Covariance Matrix\")\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(6,4))\n",
        "sns.heatmap(corr, annot=True, cmap='coolwarm')\n",
        "plt.title(\"Correlation Matrix\")\n",
        "plt.show()\n",
        "\n",
        "# 3. Eigenvalues and Eigenvectors\n",
        "values, vectors = np.linalg.eigh(cov)\n",
        "idx = np.argsort(values)[::-1]\n",
        "values, vectors = values[idx], vectors[:,idx]\n",
        "\n",
        "print(\"Eigenvalues:\\n\", values)\n",
        "print(\"Eigenvectors:\\n\", vectors)\n",
        "\n",
        "# 4. 2D Plot with top two eigenvectors\n",
        "plt.figure(figsize=(7,5))\n",
        "plt.scatter(X.iloc[:,0], X.iloc[:,1], alpha=0.5)\n",
        "plt.quiver(0, 0, vectors[0,0], vectors[1,0],\n",
        "           color='red', scale=1, angles='xy')\n",
        "plt.quiver(0, 0, vectors[0,1], vectors[1,1],\n",
        "           color='green', scale=1, angles='xy')\n",
        "plt.xlabel(\"Haemoglobin\")\n",
        "plt.ylabel(\"RBC\")\n",
        "plt.title(\"Top Two Eigenvectors\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# 5. Percentage of Variance\n",
        "variance = values / values.sum() * 100\n",
        "print(\"Variance Percentage:\\n\", variance)\n"
      ]
