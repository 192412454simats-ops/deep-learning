        "4#\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import entropy\n",
        "\n",
        "# Actual weather distribution (Sunny, Cloudy, Rainy)\n",
        "P = np.array([0.5, 0.3, 0.2])\n",
        "\n",
        "# Two prediction models\n",
        "Q1 = np.array([0.6, 0.25, 0.15])\n",
        "Q2 = np.array([0.3, 0.4, 0.3])\n",
        "\n",
        "# 1. Entropy\n",
        "H = entropy(P, base=2)\n",
        "print(\"Entropy:\", H)\n",
        "\n",
        "# 2. Cross Entropy and KL Divergence\n",
        "for Q in [Q1, Q2]:\n",
        "    CE = -np.sum(P * np.log2(Q))\n",
        "    KL = entropy(P, Q, base=2)\n",
        "    print(\"\\nCross Entropy:\", CE)\n",
        "    print(\"KL Divergence:\", KL)\n",
        "    print(\"H + KL:\", H + KL)\n",
        "\n",
        "# 3. Verify KL Divergence is asymmetric\n",
        "print(\"\\nKL(P||Q1):\", entropy(P, Q1, base=2))\n",
        "print(\"KL(Q1||P):\", entropy(Q1, P, base=2))\n",
        "\n",
        "# 4. Binary Cross Entropy Loss\n",
        "y = 1\n",
        "pred = np.linspace(0.01, 0.99, 100)\n",
        "loss = -(y*np.log(pred) + (1-y)*np.log(1-pred))\n",
        "\n",
        "plt.plot(pred, loss)\n",
        "plt.xlabel(\"Predicted Probability\")\n",
        "plt.ylabel(\"Binary Cross Entropy Loss\")\n",
        "plt.title(\"Binary Cross Entropy Loss\")\n",
        "plt.grid()\n",
        "plt.show()\n"
