        "    plt.subplot(1,4,j+1)\n",
        "    plt.imshow(v.reshape(28,28), cmap='gray')\n",
        "    plt.title(f'{steps} Steps')\n",
        "    plt.axis('off')\n",
        "plt.show()\n",
        "\n",
        "# Compare CD-1, CD-5, CD-10 and PCD\n",
        "results = {}\n",
        "for name, k, pcd in [\n",
        "    ('CD-1',1,False), ('CD-5',5,False),\n",
        "    ('CD-10',10,False), ('PCD',1,True)\n",
        "]:\n",
        "    W, a, b, err, t = train_rbm(k, pcd)\n",
