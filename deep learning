        "28# import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from tensorflow.keras.datasets import mnist\n",
        "\n",
        "# Load and binarise MNIST\n",
        "(X, _), _ = mnist.load_data()\n",
        "X = (X[:1000].reshape(-1, 784) / 255 > 0.5).astype(float)\n",
        "\n",
        "np.random.seed(42)\n",
        "nv, nh1, nh2 = 784, 128, 64\n",
        "W1 = np.random.normal(0, 0.01, (nv, nh1))\n",
        "W2 = np.random.normal(0, 0.01, (nh1, nh2))\n",
        "a, b1, b2 = np.zeros(nv), np.zeros(nh1), np.zeros(nh2)\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-np.clip(x, -50, 50)))\n",
        "\n",
        "# Mean-field inference\n",
        "def mean_field(v):\n",
        "    h1 = np.full((len(v), nh1), 0.5)\n",
        "    h2 = np.full((len(v), nh2), 0.5)\n",
        "    for _ in range(5):\n",
        "        h1 = sigmoid(v @ W1 + h2 @ W2.T + b1)\n",
        "        h2 = sigmoid(h1 @ W2 + b2)\n",
        "    return h1, h2\n",
        "\n",
        "# Approximate DBM training\n",
        "epochs, lr = 10, 0.01\n",
        "errors = []\n",
        "\n",
        "for ep in range(epochs):\n",
        "    np.random.shuffle(X)\n",
        "    total_error = 0\n",
        "\n",
        "    for i in range(0, len(X), 50):\n",
        "        v = X[i:i+50]\n",
        "        h1, h2 = mean_field(v)\n",
        "\n",
        "        # Gibbs reconstruction\n",
        "        h1_sample = (np.random.rand(*h1.shape) < h1).astype(float)\n",
        "        h2_sample = (np.random.rand(*h2.shape) < sigmoid(h1_sample @ W2 + b2)).astype(float)\n",
        "        v_prob = sigmoid(h1_sample @ W1.T + a)\n",
        "        v_sample = (np.random.rand(*v_prob.shape) < v_prob).astype(float)\n",
        "\n",
        "        # Approximate parameter updates\n",
        "        W1 += lr * (v.T @ h1 - v_sample.T @ h1_sample) / len(v)\n",
        "        W2 += lr * (h1.T @ h2 - h1_sample.T @ h2_sample) / len(v)\n",
        "        a += lr * np.mean(v - v_sample, axis=0)\n",
        "        b1 += lr * np.mean(h1 - h1_sample, axis=0)\n",
        "        b2 += lr * np.mean(h2 - h2_sample, axis=0)\n",
        "\n",
        "        total_error += np.mean((v - v_prob)**2)\n",
        "\n",
        "    errors.append(total_error / (len(X)//50))\n",
        "    print(\"Epoch\", ep+1, \"Error:\", round(errors[-1], 4))\n",
        "\n",
        "# Visualise first-layer filters\n",
        "plt.figure(figsize=(8,5))\n",
        "for i in range(20):\n",
        "    plt.subplot(4,5,i+1)\n",
        "    plt.imshow(W1[:,i].reshape(28,28), cmap='gray')\n",
        "    plt.axis('off')\n",
        "plt.suptitle(\"DBM Learned Filters\")\n",
        "plt.show()\n",
        "\n",
        "# Hidden-unit activations\n",
        "h1, h2 = mean_field(X[:5])\n",
        "plt.figure(figsize=(8,3))\n",
        "plt.imshow(h1, aspect='auto', cmap='viridis')\n",
        "plt.title(\"Hidden Layer 1 Activations\")\n",
        "plt.colorbar()\n",
        "plt.show()\n",
        "\n",
        "# Reconstruction\n",
        "reconstructed = sigmoid(h1 @ W1.T + a)\n",
