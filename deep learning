        "\n",
        "# Fashion-MNIST\n",
        "(X, _), _ = tf.keras.datasets.fashion_mnist.load_data()\n",
        "X = X.astype('float32')[..., None] / 255.\n",
        "latent_dim = 2\n",
        "\n",
        "# -------- VAE --------\n",
        "inp = layers.Input((28,28,1))\n",
        "x = layers.Flatten()(inp)\n",
        "x = layers.Dense(128, activation='relu')(x)\n",
        "mu, lv = layers.Dense(2)(x), layers.Dense(2)(x)\n",
        "\n",
        "z = layers.Lambda(lambda t: t[0]+tf.exp(.5*t[1])*\n",
        "                  tf.random.normal(tf.shape(t[0])))([mu,lv])\n",
        "encoder = Model(inp,[mu,lv,z])\n",
        "\n",
        "zi = layers.Input((2,))\n",
        "x = layers.Dense(128,activation='relu')(zi)\n",
        "out = layers.Reshape((28,28,1))(\n",
        "    layers.Dense(784,activation='sigmoid')(x))\n",
        "decoder = Model(zi,out)\n",
        "\n",
        "class VAE(Model):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.enc, self.dec = encoder, decoder\n",
        "\n",
        "    def train_step(self,data):\n",
        "        with tf.GradientTape() as tape:\n",
        "            m,l,z = self.enc(data)\n",
        "            r = self.dec(z)\n",
        "            rec = tf.reduce_mean(tf.reduce_sum(\n",
        "                tf.keras.losses.binary_crossentropy(data,r),axis=(1,2)))\n",
        "            kl = -.5*tf.reduce_mean(tf.reduce_sum(\n",
        "                1+l-m**2-tf.exp(l),axis=1))\n",
        "            loss = rec+kl\n",
        "        v = self.enc.trainable_variables+self.dec.trainable_variables\n",
        "        self.optimizer.apply_gradients(zip(tape.gradient(loss,v),v))\n",
        "        return {\"loss\":loss}\n",
        "\n",
        "vae=VAE()\n",
        "vae.compile(optimizer='adam')\n",
        "vae.fit(X,epochs=5,batch_size=128,verbose=1)\n",
        "\n",
        "# VAE samples and latent grid\n",
        "grid=np.random.uniform(-2,2,(100,2))\n",
        "imgs=decoder.predict(grid,verbose=0)\n",
        "plt.figure(figsize=(7,7))\n",
        "for i in range(100):\n",
        "    plt.subplot(10,10,i+1)\n",
        "    plt.imshow(imgs[i,:,:,0],cmap='gray')\n",
        "    plt.axis('off')\n",
