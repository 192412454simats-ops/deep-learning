        "    TabularCPD('Cough', 2, [[0.8,0.2],[0.2,0.8]],\n",
        "        evidence=['Lung Disease'], evidence_card=[2]),\n",
        "    TabularCPD('Xray', 2, [[0.9,0.1],[0.1,0.9]],\n",
        "        evidence=['Lung Disease'], evidence_card=[2]),\n",
        "    TabularCPD('Fatigue', 2, [[0.85,0.3],[0.15,0.7]],\n",
        "        evidence=['Lung Disease'], evidence_card=[2])\n",
