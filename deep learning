        "26# import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "from sklearn.datasets import fetch_openml\n",
        "\n",
        "# Load binarised MNIST\n",
        "X, _ = fetch_openml('mnist_784', version=1, return_X_y=True, as_frame=False)\n",
        "X = (X[:1000] / 255 > 0.5).astype(float)\n",
        "\n",
        "np.random.seed(42)\n",
        "nv, nh = 784, 64\n",
        "lr, epochs, batch = 0.05, 10, 50\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-np.clip(x, -50, 50)))\n",
        "\n",
        "def train_rbm(k, pcd=False):\n",
        "    W = np.random.normal(0, 0.01, (nv, nh))\n",
        "    a, b = np.zeros(nv), np.zeros(nh)\n",
        "    persistent = np.random.binomial(1, 0.5, (batch, nv))\n",
        "    errors, times = [], []\n",
        "\n",
        "    start = time.time()\n",
        "    for ep in range(epochs):\n",
        "        np.random.shuffle(X)\n",
        "        err = []\n",
        "\n",
        "        for i in range(0, len(X), batch):\n",
        "            v0 = X[i:i+batch]\n",
        "            n = len(v0)\n",
        "\n",
        "            ph0 = sigmoid(v0 @ W + b)\n",
        "            vk = persistent[:n].copy() if pcd else v0.copy()\n",
        "\n",
        "            for _ in range(k):\n",
        "                hk = (np.random.rand(n, nh) < sigmoid(vk @ W + b)).astype(float)\n",
        "                pv = sigmoid(hk @ W.T + a)\n",
        "                vk = (np.random.rand(n, nv) < pv).astype(float)\n",
        "\n",
        "            phk = sigmoid(vk @ W + b)\n",
        "\n",
        "            W += lr * (v0.T @ ph0 - vk.T @ phk) / n\n",
        "            a += lr * np.mean(v0 - vk, axis=0)\n",
        "            b += lr * np.mean(ph0 - phk, axis=0)\n",
        "\n",
        "            if pcd:\n",
        "                persistent[:n] = vk\n",
        "\n",
        "            err.append(np.mean((v0 - pv)**2))\n",
        "\n",
        "        errors.append(np.mean(err))\n",
        "\n",
        "    return W, a, b, errors, time.time()-start\n",
        "\n",
        "# Gibbs sampling from random noise\n",
        "W, a, b, _, _ = train_rbm(1)\n",
        "v = np.random.binomial(1, 0.5, (1, nv))\n",
