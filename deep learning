        "# Exact inference\n",
        "infer = VariableElimination(model)\n",
        "evidence_list = [\n",
        "    {'Xray': 1, 'Cough': 1},\n",
        "    {'Xray': 1, 'Cough': 1, 'Smoking': 1},\n",
        "    {'Xray': 1, 'Cough': 1, 'Smoking': 0}\n",
