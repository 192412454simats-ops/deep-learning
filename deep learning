        "8#\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import make_moons\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate two-moons dataset\n",
        "X, y = make_moons(n_samples=200, noise=0.15)\n",
        "y = y.reshape(-1, 1)\n",
        "\n",
        "# 1. Initialize weights\n",
        "W1 = np.random.randn(2, 8) * 0.5\n",
        "b1 = np.zeros((1, 8))\n",
        "W2 = np.random.randn(8, 1) * 0.5\n",
        "b2 = np.zeros((1, 1))\n",
        "\n",
        "lr = 0.5\n",
        "losses = []\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1/(1+np.exp(-x))\n",
        "\n",
        "# 2 & 3. Forward and backward propagation\n",
        "for epoch in range(5000):\n",
        "\n",
        "    # Forward pass\n",
        "    Z1 = X @ W1 + b1\n",
        "    A1 = sigmoid(Z1)\n",
        "    Z2 = A1 @ W2 + b2\n",
        "    A2 = sigmoid(Z2)\n",
        "\n",
        "    # Binary cross entropy loss\n",
        "    loss = -np.mean(y*np.log(A2+1e-8) +\n",
        "                    (1-y)*np.log(1-A2+1e-8))\n",
        "    losses.append(loss)\n",
        "\n",
        "    # Backward pass\n",
        "    dZ2 = A2-y\n",
        "    dW2 = A1.T @ dZ2 / len(X)\n",
        "    db2 = np.mean(dZ2, axis=0, keepdims=True)\n",
        "\n",
        "    dA1 = dZ2 @ W2.T\n",
        "    dZ1 = dA1*A1*(1-A1)\n",
        "    dW1 = X.T @ dZ1 / len(X)\n",
        "    db1 = np.mean(dZ1, axis=0, keepdims=True)\n",
        "\n",
        "    # Update weights\n",
        "    W1 -= lr*dW1\n",
        "    b1 -= lr*db1\n",
        "    W2 -= lr*dW2\n",
        "    b2 -= lr*db2\n",
        "\n",
        "# 4. Plot loss\n",
        "plt.plot(losses)\n",
        "plt.xlabel(\"Epochs\")\n",
        "plt.ylabel(\"Loss\")\n",
        "plt.title(\"Backpropagation Training Loss\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# 5. Decision boundary\n",
        "xx, yy = np.meshgrid(\n",
        "    np.linspace(X[:,0].min()-0.5, X[:,0].max()+0.5, 100),\n",
        "    np.linspace(X[:,1].min()-0.5, X[:,1].max()+0.5, 100))\n",
        "\n",
        "grid = np.c_[xx.ravel(), yy.ravel()]\n",
        "A1 = sigmoid(grid @ W1+b1)\n",
        "pred = sigmoid(A1 @ W2+b2).reshape(xx.shape)\n",
        "\n",
        "plt.contourf(xx, yy, pred, levels=[0,0.5,1], alpha=0.3)\n",
        "plt.scatter(X[:,0], X[:,1], c=y.ravel(), cmap='bwr')\n",
        "plt.title(\"Non-linear Decision Boundary\")\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.show()\n",
        "\n",
        "# Numerical gradient verification for W1[0,0]\n",
        "def calculate_loss(w):\n",
        "    a1 = sigmoid(X @ w+b1)\n",
        "    a2 = sigmoid(a1 @ W2+b2)\n",
        "    return -np.mean(y*np.log(a2+1e-8) +\n",
        "                    (1-y)*np.log(1-a2+1e-8))\n",
        "\n",
        "epsilon = 1e-5\n",
        "W_temp = W1.copy()\n",
        "W_temp[0,0] += epsilon\n",
        "L1 = calculate_loss(W_temp)\n",
        "\n",
        "W_temp[0,0] -= 2*epsilon\n",
        "L2 = calculate_loss(W_temp)\n",
        "\n",
        "numerical_grad = (L1-L2)/(2*epsilon)\n",
        "analytical_grad = dW1[0,0]\n",
        "\n",
        "print(\"Numerical Gradient:\", numerical_grad)\n",
        "print(\"Analytical Gradient:\", analytical_grad)\n",
        "print(\"Final Loss:\", losses[-1])\n"
      ]
