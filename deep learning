        "            cmap='tab10', s=10)\n",
        "plt.colorbar(label=\"Digit Class\")\n",
        "plt.title(\"DBN Learned Representations (PCA)\")\n",
        "plt.xlabel(\"Component 1\")\n",
        "plt.ylabel(\"Component 2\")\n",
        "plt.show()"
