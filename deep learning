        "25# import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import fetch_openml\n",
        "\n",
        "# Load and binarise MNIST\n",
        "X, _ = fetch_openml('mnist_784', version=1, return_X_y=True, as_frame=False)\n",
        "X = (X[:1000] / 255 > 0.5).astype(float)\n",
        "\n",
        "# RBM parameters\n",
        "np.random.seed(42)\n",
        "n_visible, n_hidden = 784, 64\n",
        "W = np.random.normal(0, 0.01, (n_visible, n_hidden))\n",
        "a = np.zeros(n_visible)\n",
        "b = np.zeros(n_hidden)\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-np.clip(x, -50, 50)))\n",
        "\n",
        "# Energy function\n",
        "def energy(v, h):\n",
        "    return -np.dot(a, v) - np.dot(b, h) - np.dot(v, W @ h)\n",
        "\n",
        "# Training using CD-1\n",
        "epochs, batch_size, lr = 10, 50, 0.1\n",
        "free_energy, errors = [], []\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    np.random.shuffle(X)\n",
        "    total_error, total_energy = 0, 0\n",
        "\n",
        "    for i in range(0, len(X), batch_size):\n",
        "        v0 = X[i:i+batch_size]\n",
        "        if len(v0) == 0: continue\n",
        "\n",
        "        # Positive phase\n",
        "        ph0 = sigmoid(v0 @ W + b)\n",
        "        h0 = (np.random.rand(*ph0.shape) < ph0).astype(float)\n",
        "\n",
        "        # Negative phase\n",
        "        pv1 = sigmoid(h0 @ W.T + a)\n",
        "        v1 = (np.random.rand(*pv1.shape) < pv1).astype(float)\n",
        "        ph1 = sigmoid(v1 @ W + b)\n",
        "\n",
        "        # Update weights and biases\n",
        "        W += lr * (v0.T @ ph0 - v1.T @ ph1) / len(v0)\n",
        "        a += lr * np.mean(v0 - v1, axis=0)\n",
        "        b += lr * np.mean(ph0 - ph1, axis=0)\n",
        "\n",
        "        total_error += np.mean((v0 - pv1)**2)\n",
        "        total_energy += np.mean(\n",
