        "19# import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import fetch_olivetti_faces\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# Load dataset\n",
        "X = fetch_olivetti_faces().data\n",
        "mean = X.mean(axis=0)\n",
        "Xc = X - mean\n",
        "\n",
        "# PCA from scratch\n",
        "cov = np.cov(Xc, rowvar=False)\n",
        "eigval, eigvec = np.linalg.eigh(cov)\n",
        "idx = np.argsort(eigval)[::-1]\n",
        "eigval, eigvec = eigval[idx], eigvec[:, idx]\n",
        "\n",
        "variance = eigval / eigval.sum()\n",
        "cumulative = np.cumsum(variance)\n",
        "k95 = np.argmax(cumulative >= 0.95) + 1\n",
        "print(\"Components for 95% variance:\", k95)\n",
        "\n",
        "# Verify with sklearn PCA\n",
        "pca = PCA().fit(X)\n",
        "print(\"Sklearn 95% components:\",\n",
        "      np.argmax(np.cumsum(pca.explained_variance_ratio_) >= 0.95) + 1)\n",
        "\n",
        "# Scree and cumulative variance plots\n",
        "plt.plot(variance[:100], label=\"Scree\")\n",
