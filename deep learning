        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.decomposition import FactorAnalysis, PCA\n",
        "from scipy.linalg import orthogonal_procrustes\n",
        "\n",
        "# Generate survey data\n",
        "np.random.seed(42)\n",
        "X = pd.DataFrame(np.random.randint(1, 6, (300, 10)),\n",
        " columns=['Pay','Salary','Bonus','Workload','Stress','Support',\n",
        "          'Manager','Growth','Training','Team'])\n",
        "\n",
        "print(X.head())\n",
        "print(X.corr())\n",
        "\n",
        "# Factor Analysis with 2, 3 and 4 factors\n",
        "for n in [2, 3, 4]:\n",
        "    fa = FactorAnalysis(n_components=n, random_state=42)\n",
        "    fa.fit(X)\n",
        "    loadings = fa.components_.T\n",
        "\n",
        "    # Varimax rotation\n",
        "    def varimax(Phi):\n",
        "        p, k = Phi.shape\n",
        "        R = np.eye(k)\n",
        "        for _ in range(100):\n",
        "            L = Phi @ R\n",
        "            u, s, vh = np.linalg.svd(\n",
        "                Phi.T @ (L**3 - (1/p)*L @ np.diag(np.diag(L.T @ L)))\n",
        "            )\n",
        "            R = u @ vh\n",
        "        return Phi @ R\n",
        "\n",
        "    loadings = varimax(loadings)\n",
        "    print(f\"\\n{n} Factors:\\n\", np.round(loadings, 2))\n",
        "\n",
        "    sns.heatmap(loadings, annot=True, cmap='coolwarm',\n",
        "                xticklabels=[f'F{i+1}' for i in range(n)],\n",
        "                yticklabels=X.columns)\n",
        "    plt.title(f'{n} Factor Loadings')\n",
        "    plt.show()\n",
        "\n",
        "# PCA comparison\n",
        "pca = PCA(n_components=3).fit(X)\n",
        "print(\"PCA Explained Variance:\", pca.explained_variance_ratio_)\n",
        "print(\"Factor Analysis Noise Variance:\", fa.noise_variance_)"
      ]
