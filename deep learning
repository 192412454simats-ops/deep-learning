        "#13\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "import os\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "\n",
        "# 1. Load dataset (generate synthetic electricity consumption data if file is missing)\n",
        "file_path = '/content/electricity.csv'\n",
        "if not os.path.exists(file_path):\n",
        "    print(f\"File {file_path} not found. Creating a realistic synthetic dataset...\")\n",
        "    np.random.seed(42)\n",
        "    # Create hourly timestamps for 30 days (720 hours)\n",
        "    timestamps = pd.date_range(start=\"2023-01-01\", periods=720, freq=\"h\")\n",
        "    # Generate base load, daily sin/cos pattern, weekly cycle, and random noise\n",
        "    base_load = 500.0\n",
        "    hour_effect = 150 * np.sin(2 * np.pi * timestamps.hour / 24.0)\n",
        "    day_effect = 50 * np.cos(2 * np.pi * timestamps.dayofweek / 7.0)\n",
        "    noise = np.random.normal(0, 30, len(timestamps))\n",
        "    consumption = base_load + hour_effect + day_effect + noise\n",
        "\n",
        "    df_synthetic = pd.DataFrame({\n",
        "        'Timestamp': timestamps,\n",
        "        'Consumption': consumption\n",
        "    })\n",
        "    df_synthetic.to_csv(file_path, index=False)\n",
        "    print(f\"Successfully saved synthetic dataset to {file_path}.\")\n",
        "\n",
        "df = pd.read_csv(file_path)\n",
        "\n",
        "# Handle missing values\n",
        "series = pd.to_numeric(\n",
        "    df['Consumption'], errors='coerce'\n",
        ").interpolate().ffill().bfill().values.reshape(-1, 1)\n",
        "\n",
        "# 2. Scale the data\n",
        "scaler = MinMaxScaler()\n",
        "scaled_data = scaler.fit_transform(series)\n",
        "\n",
        "# 3. Create sliding windows\n",
        "window_size = 24\n",
        "\n",
        "X, y = [], []\n",
        "\n",
        "for i in range(window_size, len(scaled_data)):\n",
        "    X.append(scaled_data[i-window_size:i])\n",
        "    y.append(scaled_data[i])\n",
        "\n",
        "X = np.array(X)\n",
        "y = np.array(y)\n",
        "\n",
        "print(\"Input shape:\", X.shape)\n",
        "print(\"Target shape:\", y.shape)\n",
        "\n",
        "# 4. Chronological train-test split\n",
        "split = int(len(X) * 0.8)\n",
        "\n",
        "X_train, X_test = X[:split], X[split:]\n",
        "y_train, y_test = y[:split], y[split:]\n",
        "\n",
        "print(\"Training samples:\", len(X_train))\n",
        "print(\"Testing samples:\", len(X_test))\n",
        "\n",
        "# 5. Build SimpleRNN model\n",
        "model = tf.keras.Sequential([\n",
        "    tf.keras.layers.Input(shape=(window_size, 1)),\n",
        "    tf.keras.layers.SimpleRNN(50, activation='tanh'),\n",
        "    tf.keras.layers.Dense(1)\n",
        "])\n",
        "\n",
        "model.compile(\n",
        "    optimizer='adam',\n",
        "    loss='mse',\n",
        "    metrics=['mae']\n",
        ")\n",
        "\n",
        "# 6. Train model\n",
        "history = model.fit(\n",
        "    X_train, y_train,\n",
        "    epochs=30,\n",
        "    batch_size=32,\n",
        "    validation_split=0.2,\n",
        "    shuffle=False,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# 7. Predict and reverse scaling\n",
        "predicted = model.predict(X_test)\n",
        "\n",
        "actual = scaler.inverse_transform(y_test)\n",
        "predicted = scaler.inverse_transform(predicted)\n",
        "\n",
        "# 8. Calculate MAE and RMSE\n",
        "mae = mean_absolute_error(actual, predicted)\n",
        "rmse = np.sqrt(mean_squared_error(actual, predicted))\n",
        "\n",
        "print(\"MAE:\", round(mae, 3))\n",
        "print(\"RMSE:\", round(rmse, 3))\n",
        "\n",
        "# 9. Plot actual vs predicted demand\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.plot(actual, label='Actual Demand')\n",
        "plt.plot(predicted, label='Predicted Demand')\n",
        "plt.xlabel('Test Time Steps')\n",
        "plt.ylabel('Electricity Consumption')\n",
        "plt.title('Actual vs Predicted Electricity Demand')\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# 10. Plot training and validation loss\n",
        "plt.figure(figsize=(8, 4))\n",
        "plt.plot(history.history['loss'], label='Training Loss')\n",
        "plt.plot(history.history['val_loss'], label='Validation Loss')\n",
        "plt.xlabel('Epoch')\n",
        "plt.ylabel('MSE Loss')\n",
        "plt.title('SimpleRNN Training Performance')\n",
        "plt.legend()\n",
        "plt.show()"
      ]
    },
