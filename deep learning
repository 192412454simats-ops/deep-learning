        "#3\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import bernoulli, binom, poisson, uniform, norm\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# 1. Generate probability distribution samples\n",
        "samples = [\n",
        "    bernoulli.rvs(0.5, size=1000),\n",
        "    binom.rvs(10, 0.5, size=1000),\n",
        "    poisson.rvs(5, size=1000),\n",
        "    uniform.rvs(0, 10, size=1000),\n",
        "    norm.rvs(50, 10, size=1000)\n",
        "]\n",
        "\n",
        "titles = ['Bernoulli', 'Binomial', 'Poisson', 'Uniform', 'Gaussian']\n",
        "\n",
        "for s, t in zip(samples, titles):\n",
        "    plt.hist(s, bins=20, density=True, alpha=0.6)\n",
        "    plt.title(t + ' Distribution')\n",
        "    plt.show()\n",
        "\n",
        "# 2. Bayes' Theorem\n",
        "P_D = 0.01\n",
        "P_Pos_D = 0.95\n",
        "P_Pos_NoD = 0.10\n",
        "\n",
        "P_Pos = P_Pos_D*P_D + P_Pos_NoD*(1-P_D)\n",
        "posterior = (P_Pos_D*P_D)/P_Pos\n",
        "\n",
        "print(\"P(Disease | Positive):\", posterior)\n",
        "\n",
        "# 3. Simulate 100,000 patients\n",
        "n = 100000\n",
        "disease = np.random.rand(n) < P_D\n",
        "positive = np.where(disease,\n",
        "                    np.random.rand(n) < P_Pos_D,\n",
        "                    np.random.rand(n) < P_Pos_NoD)\n",
        "\n",
        "empirical = np.sum(disease & positive) / np.sum(positive)\n",
        "print(\"Empirical Probability:\", empirical)\n",
        "\n",
        "# 4. Posterior vs Prevalence\n",
        "prevalence = np.linspace(0.001, 0.20, 100)\n",
        "post = (P_Pos_D*prevalence) / (\n",
        "    P_Pos_D*prevalence + P_Pos_NoD*(1-prevalence))\n",
        "\n",
        "plt.plot(prevalence*100, post*100)\n",
        "plt.xlabel(\"Disease Prevalence (%)\")\n",
        "plt.ylabel(\"Posterior Probability (%)\")\n",
        "plt.title(\"Bayes Theorem: Posterior vs Prevalence\")\n",
        "plt.grid()\n",
        "plt.show()\n"
      ]
