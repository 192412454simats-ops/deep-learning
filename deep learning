        "30#\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from tensorflow.keras import layers, Model\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.metrics import pairwise_distances\n",
        "from scipy.linalg import sqrtm\n",
        "\n",
        "# 1. Load Fashion-MNIST\n",
        "(x_train, y_train), (x_test, y_test) = tf.keras.datasets.fashion_mnist.load_data()\n",
        "x_train = x_train.astype(\"float32\")[..., None] / 255.\n",
        "x_test = x_test.astype(\"float32\")[..., None] / 255.\n",
        "\n",
        "# 2. Generate 1000 images from each model (Experiment 29)\n",
        "vae_images = decoder.predict(np.random.normal(size=(1000, 2)), verbose=0)\n",
        "gan_images = (G.predict(np.random.normal(size=(1000, 100)), verbose=0) + 1) / 2\n",
        "vae_images = np.clip(vae_images, 0, 1)\n",
        "gan_images = np.clip(gan_images, 0, 1)\n",
        "\n",
        "# 3. Train a Fashion-MNIST classifier\n",
        "inp = layers.Input((28, 28, 1))\n",
        "x = layers.Conv2D(32, 3, activation=\"relu\")(inp)\n",
        "x = layers.MaxPooling2D()(x)\n",
        "x = layers.Conv2D(64, 3, activation=\"relu\")(x)\n",
        "x = layers.Flatten()(x)\n",
        "features = layers.Dense(128, activation=\"relu\", name=\"features\")(x)\n",
        "out = layers.Dense(10, activation=\"softmax\")(features)\n",
        "\n",
        "clf = Model(inp, out)\n",
        "clf.compile(optimizer=\"adam\", loss=\"sparse_categorical_crossentropy\",\n",
        "            metrics=[\"accuracy\"])\n",
        "clf.fit(x_train, y_train, epochs=3, batch_size=128, verbose=1)\n",
        "\n",
        "feature_model = Model(clf.input, clf.get_layer(\"features\").output)\n",
        "\n",
        "# 4. Extract predictions and features\n",
        "real = x_test[:1000]\n",
        "real_f = feature_model.predict(real, verbose=0)\n",
        "real_p = clf.predict(real, verbose=0)\n",
        "\n",
        "def evaluate(images):\n",
        "    f = feature_model.predict(images, verbose=0)\n",
        "    p = clf.predict(images, verbose=0)\n",
        "\n",
        "    # Classifier-based Inception Score\n",
        "    scores = []\n",
        "    for part in np.array_split(p, 10):\n",
        "        marginal = np.mean(part, axis=0)\n",
        "        kl = np.sum(part * (np.log(part + 1e-10) -\n",
        "                            np.log(marginal + 1e-10)), axis=1)\n",
        "        scores.extend(np.exp(kl))\n",
        "    inception = np.mean(scores)\n",
        "\n",
        "    # FID\n",
        "    m1, m2 = real_f.mean(axis=0), f.mean(axis=0)\n",
        "    c1, c2 = np.cov(real_f, rowvar=False), np.cov(f, rowvar=False)\n",
        "    covmean = sqrtm(c1 @ c2)\n",
        "    if np.iscomplexobj(covmean):\n",
        "        covmean = covmean.real\n",
        "    fid = np.sum((m1-m2)**2) + np.trace(c1+c2-2*covmean)\n",
        "\n",
        "    # Class distribution and normalized entropy\n",
        "    counts = np.bincount(np.argmax(p, axis=1), minlength=10)\n",
        "    prob = counts / counts.sum()\n",
        "    entropy = -np.sum(prob * np.log(prob + 1e-10)) / np.log(10)\n",
        "\n",
        "    # Feature diversity: mean pairwise distance\n",
        "    diversity = pairwise_distances(f[:300]).mean()\n",
        "\n",
        "    return inception, fid, entropy, diversity, counts, f\n",
        "\n",
        "# 5. Evaluate VAE and GAN\n",
        "v = evaluate(vae_images)\n",
        "g = evaluate(gan_images)\n",
        "\n",
        "# 6. Display metric comparison\n",
        "results = pd.DataFrame({\n",
        "    \"Metric\": [\"Inception Score ↑\", \"FID ↓\",\n",
        "               \"Class Diversity ↑\", \"Feature Diversity ↑\"],\n",
        "    \"VAE\": [v[0], v[1], v[2], v[3]],\n",
        "    \"GAN\": [g[0], g[1], g[2], g[3]]\n",
        "})\n",
        "print(\"\\nMODEL COMPARISON\")\n",
        "print(results.round(4).to_string(index=False))\n",
        "\n",
        "# 7. Predicted class distribution\n",
        "classes = [\"T-shirt\", \"Trouser\", \"Pullover\", \"Dress\", \"Coat\",\n",
        "           \"Sandal\", \"Shirt\", \"Sneaker\", \"Bag\", \"Boot\"]\n",
        "distribution = pd.DataFrame({\n",
        "    \"Class\": classes,\n",
        "    \"VAE Samples\": v[4],\n",
        "    \"GAN Samples\": g[4]\n",
        "})\n",
        "print(\"\\nGENERATED CLASS DISTRIBUTION\")\n",
        "print(distribution.to_string(index=False))\n",
        "\n",
        "distribution.set_index(\"Class\").plot(kind=\"bar\", figsize=(10,4))\n",
        "plt.title(\"Generated Image Class Distribution\")\n",
        "plt.ylabel(\"Number of Images\")\n",
        "plt.xticks(rotation=45)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 8. PCA visualization of real and generated features\n",
        "all_features = np.vstack([real_f, v[5], g[5]])\n",
        "pca = PCA(n_components=2)\n",
        "reduced = pca.fit_transform(all_features)\n",
        "\n",
        "plt.figure(figsize=(8,6))\n",
        "plt.scatter(*reduced[:1000].T, s=8, label=\"Real\", alpha=.4)\n",
        "plt.scatter(*reduced[1000:2000].T, s=8, label=\"VAE\", alpha=.4)\n",
        "plt.scatter(*reduced[2000:].T, s=8, label=\"GAN\", alpha=.4)\n",
        "plt.title(\"PCA: Real vs Generated Features\")\n",
        "plt.xlabel(\"Principal Component 1\")\n",
        "plt.ylabel(\"Principal Component 2\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# 9. Recommendation\n",
        "if g[1] < v[1] and g[2] >= v[2]:\n",
        "    print(\"Recommendation: GAN performs better based on FID and diversity.\")\n",
        "elif v[1] < g[1] and v[2] >= g[2]:\n",
        "    print(\"Recommendation: VAE performs better based on FID and diversity.\")\n",
        "else:\n",
        "    print(\"Recommendation: Compare all metrics and sample images before selection.\")\n",
        "\n",
        "print(\"\\nExperiment 30 completed!\")\n"
