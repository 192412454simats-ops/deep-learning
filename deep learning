        "16#\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "import os\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "\n",
        "# 1. Load dataset (generate synthetic daily orders data if file is missing)\n",
        "file_path = '/content/daily_orders.csv'\n",
        "if not os.path.exists(file_path):\n",
        "    print(f\"File {file_path} not found. Creating a realistic synthetic dataset...\")\n",
        "    np.random.seed(42)\n",
        "    # Create daily timestamps for 500 days\n",
        "    timestamps = pd.date_range(start=\"2022-01-01\", periods=500, freq=\"D\")\n",
        "    # Generate base orders, a weekly cycle, and random noise\n",
        "    base_orders = 300.0\n",
        "    week_effect = 80 * np.sin(2 * np.pi * timestamps.dayofweek / 7.0)\n",
        "    noise = np.random.normal(0, 15, len(timestamps))\n",
        "    orders = np.maximum(50, base_orders + week_effect + noise).astype(int)\n",
        "\n",
        "    df_synthetic = pd.DataFrame({\n",
        "        'Date': timestamps,\n",
        "        'Orders': orders\n",
        "    })\n",
        "    df_synthetic.to_csv(file_path, index=False)\n",
        "    print(f\"Successfully saved synthetic dataset to {file_path}.\")\n",
        "\n",
        "df = pd.read_csv(file_path)\n",
        "\n",
        "df['Orders'] = pd.to_numeric(\n",
        "    df['Orders'], errors='coerce'\n",
        ")\n",
        "values = df['Orders'].interpolate().ffill().bfill().values.reshape(-1, 1)\n",
        "\n",
        "# 2. Chronological split and scaling\n",
        "split = int(len(values) * 0.8)\n",
        "\n",
        "scaler = MinMaxScaler()\n",
        "train_data = scaler.fit_transform(values[:split])\n",
        "all_data = scaler.transform(values)\n",
        "\n",
        "# 3. Create 30-day sequences\n",
        "window = 30\n",
        "\n",
        "def create_sequences(data):\n",
        "    X, y = [], []\n",
        "    for i in range(window, len(data)):\n",
        "        X.append(data[i-window:i])\n",
        "        y.append(data[i])\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "X, y = create_sequences(all_data)\n",
        "\n",
        "train_end = split - window\n",
        "\n",
        "X_train, y_train = X[:train_end], y[:train_end]\n",
        "X_test, y_test = X[train_end:], y[train_end:]\n",
        "\n",
        "# Validation data from the end of training period\n",
        "val_start = int(len(X_train) * 0.8)\n",
        "\n",
        "X_fit, y_fit = X_train[:val_start], y_train[:val_start]\n",
        "X_val, y_val = X_train[val_start:], y_train[val_start:]\n",
        "\n",
        "print(\"Training samples:\", len(X_fit))\n",
        "print(\"Validation samples:\", len(X_val))\n",
        "print(\"Testing samples:\", len(X_test))\n",
        "\n",
        "# 4. Model creation function\n",
        "def build_model(model_type):\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Input(shape=(30, 1))\n",
        "    ])\n",
        "\n",
        "    if model_type == 'SimpleRNN':\n",
        "        model.add(tf.keras.layers.SimpleRNN(50))\n",
        "    else:\n",
        "        model.add(tf.keras.layers.LSTM(50))\n",
        "\n",
        "    model.add(tf.keras.layers.Dense(1))\n",
        "\n",
        "    model.compile(\n",
        "        optimizer='adam',\n",
        "        loss='mse',\n",
        "        metrics=['mae']\n",
        "    )\n",
        "    return model\n",
        "\n",
        "# 5. Train SimpleRNN and LSTM\n",
        "models = {}\n",
        "histories = {}\n",
        "times = {}\n",
        "predictions = {}\n",
        "\n",
        "for name in ['SimpleRNN', 'LSTM']:\n",
        "\n",
        "    tf.keras.utils.set_random_seed(42)\n",
        "\n",
        "    model = build_model(name)\n",
        "\n",
        "    start = time.time()\n",
        "\n",
        "    history = model.fit(\n",
        "        X_fit, y_fit,\n",
        "        validation_data=(X_val, y_val),\n",
        "        epochs=30,\n",
        "        batch_size=32,\n",
        "        shuffle=False,\n",
        "        verbose=1\n",
        "    )\n",
        "\n",
        "    times[name] = time.time() - start\n",
        "\n",
        "    models[name] = model\n",
        "    histories[name] = history\n",
        "\n",
        "    pred = model.predict(X_test, verbose=0)\n",
        "\n",
        "    predictions[name] = scaler.inverse_transform(pred)\n",
        "\n",
        "# 6. Convert actual values back to original scale\n",
        "actual = scaler.inverse_transform(y_test)\n",
        "\n",
        "# 7. Calculate evaluation metrics\n",
        "results = []\n",
        "\n",
        "for name in ['SimpleRNN', 'LSTM']:\n",
        "\n",
        "    pred = predictions[name]\n",
        "\n",
        "    mae = mean_absolute_error(actual, pred)\n",
        "    rmse = np.sqrt(mean_squared_error(actual, pred))\n",
        "\n",
        "    # Avoid division by zero in MAPE\n",
        "    mape = np.mean(\n",
        "        np.abs((actual - pred) / np.maximum(np.abs(actual), 1e-8))\n",
        "    ) * 100\n",
        "\n",
        "    results.append({\n",
        "        'Model': name,\n",
        "        'MAE': mae,\n",
        "        'RMSE': rmse,\n",
        "        'MAPE (%)': mape,\n",
        "        'Training Time (sec)': times[name],\n",
        "        'Parameters': models[name].count_params()\n",
        "    })\n",
        "\n",
        "# 8. Display comparison table\n",
        "result_df = pd.DataFrame(results)\n",
        "\n",
        "print(\"\\nMODEL PERFORMANCE COMPARISON\")\n",
        "print(result_df.round(3).to_string(index=False))\n",
        "\n",
        "# 9. Plot training and validation loss\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "for name in ['SimpleRNN', 'LSTM']:\n",
        "    plt.plot(\n",
        "        histories[name].history['loss'],\n",
        "        label=name + ' Training Loss'\n",
        "    )\n",
        "    plt.plot(\n",
        "        histories[name].history['val_loss'],\n",
        "        linestyle='--',\n",
        "        label=name + ' Validation Loss'\n",
        "    )\n",
        "\n",
        "plt.xlabel('Epoch')\n",
        "plt.ylabel('MSE Loss')\n",
        "plt.title('SimpleRNN vs LSTM Loss Comparison')\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# 10. Plot actual vs predicted orders\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "plt.plot(actual, label='Actual Orders', linewidth=2)\n",
        "plt.plot(predictions['SimpleRNN'], label='SimpleRNN Prediction')\n",
        "plt.plot(predictions['LSTM'], label='LSTM Prediction')\n",
        "\n",
        "plt.xlabel('Test Days')\n",
        "plt.ylabel('Daily Orders')\n",
        "plt.title('Actual vs Predicted Daily Orders')\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# 11. Plot training time comparison\n",
        "plt.figure(figsize=(6, 4))\n",
        "plt.bar(result_df['Model'], result_df['Training Time (sec)'])\n",
        "plt.ylabel('Training Time (seconds)')\n",
        "plt.title('Training Time Comparison')\n",
        "plt.show()\n"
      ]
