        "14#\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import networkx as nx\n",
        "\n",
        "# 1. Five-word sentence and numerical word vectors\n",
        "words = [\"I\", \"love\", \"machine\", \"learning\", \"models\"]\n",
        "\n",
        "# Each word is represented by a 4-dimensional vector\n",
        "X = np.array([[\n",
        "    [0.2, 0.4, 0.1, 0.3],\n",
        "    [0.5, 0.1, 0.6, 0.2],\n",
        "    [0.3, 0.7, 0.2, 0.5],\n",
        "    [0.6, 0.2, 0.4, 0.1],\n",
        "    [0.1, 0.5, 0.3, 0.7]\n",
        "]], dtype=np.float32)\n",
        "\n",
        "# 2. Build SimpleRNN model\n",
        "inputs = tf.keras.Input(shape=(5, 4))\n",
        "\n",
        "rnn_layer = tf.keras.layers.SimpleRNN(\n",
        "    3, activation='tanh',\n",
        "    return_sequences=True,\n",
        "    name='simple_rnn'\n",
        ")\n",
        "\n",
        "hidden = rnn_layer(inputs)\n",
        "outputs = tf.keras.layers.Dense(1, name='output')(hidden)\n",
        "\n",
        "model = tf.keras.Model(inputs, outputs)\n",
        "\n",
        "# Initialize model weights\n",
        "keras_output = model.predict(X, verbose=0)\n",
        "\n",
        "# 3. Extract weights\n",
        "Wxh, Whh, bh = rnn_layer.get_weights()\n",
        "\n",
        "output_layer = model.get_layer('output')\n",
        "Why, by = output_layer.get_weights()\n",
        "\n",
        "print(\"Input weights W_xh:\\n\", Wxh)\n",
        "print(\"Recurrent weights W_hh:\\n\", Whh)\n",
        "print(\"Hidden bias:\\n\", bh)\n",
        "print(\"Output weights W_hy:\\n\", Why)\n",
        "print(\"Output bias:\\n\", by)\n",
        "\n",
        "# 4. Manually calculate hidden states\n",
        "h_previous = np.zeros(3)\n",
        "manual_states = []\n",
        "manual_outputs = []\n",
        "\n",
        "for t in range(5):\n",
        "    x_t = X[0, t, :]\n",
        "\n",
        "    h_t = np.tanh(\n",
        "        np.dot(x_t, Wxh) +\n",
        "        np.dot(h_previous, Whh) + bh\n",
        "    )\n",
        "\n",
        "    y_t = np.dot(h_t, Why) + by\n",
        "\n",
        "    manual_states.append(h_t)\n",
        "    manual_outputs.append(y_t[0])\n",
        "\n",
        "    h_previous = h_t\n",
        "\n",
        "manual_states = np.array(manual_states)\n",
        "manual_outputs = np.array(manual_outputs)\n",
        "\n",
        "# 5. Compare manual states with Keras states\n",
        "# Build an intermediate model to extract the concrete hidden states for X\n",
        "intermediate_model = tf.keras.Model(inputs=inputs, outputs=hidden)\n",
        "keras_states = intermediate_model.predict(X, verbose=0)[0]\n",
        "\n",
        "print(\"\\nManual Hidden States:\")\n",
        "print(np.round(manual_states, 4))\n",
        "\n",
        "print(\"\\nKeras Hidden States:\")\n",
        "print(np.round(keras_states, 4))\n",
        "\n",
        "print(\"\\nMaximum Difference:\",\n",
        "      np.max(np.abs(manual_states - keras_states)))\n",
        "\n",
        "print(\"\\nManual Outputs:\", np.round(manual_outputs, 4))\n",
        "print(\"Keras Outputs:\", np.round(keras_output[0, :, 0], 4))\n",
        "\n",
        "# 6. Draw unfolded RNN using NetworkX\n",
        "G = nx.DiGraph()\n",
        "pos = {}\n",
        "\n",
        "for t in range(5):\n",
        "    x_node = f\"x{t+1}\"\n",
        "    h_node = f\"h{t+1}\"\n",
        "    y_node = f\"y{t+1}\"\n",
        "\n",
        "    G.add_node(x_node, kind='input')\n",
        "    G.add_node(h_node, kind='hidden')\n",
        "    G.add_node(y_node, kind='output')\n",
        "\n",
        "    pos[x_node] = (t * 3, 2)\n",
        "    pos[h_node] = (t * 3, 1)\n",
        "    pos[y_node] = (t * 3, 0)\n",
        "\n",
        "    G.add_edge(x_node, h_node, label='W_xh')\n",
        "    G.add_edge(h_node, y_node, label='W_hy')\n",
        "\n",
        "    if t > 0:\n",
        "        G.add_edge(f\"h{t}\", h_node, label='W_hh')\n",
        "\n",
        "# Initial hidden state\n",
        "G.add_node(\"h0\", kind='hidden')\n",
        "pos[\"h0\"] = (-3, 1)\n",
        "G.add_edge(\"h0\", \"h1\", label='W_hh')\n",
        "\n",
        "# Draw graph\n",
        "plt.figure(figsize=(16, 6))\n",
        "\n",
        "nx.draw_networkx_nodes(\n",
        "    G, pos, nodelist=[f\"x{i}\" for i in range(1, 6)],\n",
        "    node_color='lightblue', node_size=1500\n",
        ")\n",
        "\n",
        "nx.draw_networkx_nodes(\n",
        "    G, pos, nodelist=[f\"h{i}\" for i in range(6)],\n",
        "    node_color='lightgreen', node_size=1500\n",
        ")\n",
        "\n",
        "nx.draw_networkx_nodes(\n",
        "    G, pos, nodelist=[f\"y{i}\" for i in range(1, 6)],\n",
        "    node_color='lightyellow', node_size=1500\n",
        ")\n",
        "\n",
        "nx.draw_networkx_edges(\n",
        "    G, pos, arrows=True, arrowsize=20,\n",
        "    connectionstyle='arc3,rad=0.05'\n",
        ")\n",
        "\n",
        "labels = {}\n",
        "for t in range(5):\n",
        "    labels[f\"x{t+1}\"] = f\"x{t+1}\\n{words[t]}\"\n",
        "    labels[f\"h{t+1}\"] = f\"h{t+1}\"\n",
        "    labels[f\"y{t+1}\"] = f\"y{t+1}\"\n",
        "\n",
        "labels[\"h0\"] = \"h0\"\n",
        "\n",
        "nx.draw_networkx_labels(G, pos, labels, font_size=9)\n",
        "\n",
        "edge_labels = nx.get_edge_attributes(G, 'label')\n",
        "nx.draw_networkx_edge_labels(\n",
        "    G, pos, edge_labels=edge_labels, font_size=8\n",
        ")\n",
        "\n",
