      "source": [
        "12#\n",
        "import os, time, itertools\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from pathlib import Path\n",
        "from sklearn.model_selection import train_test_split, ParameterGrid\n",
        "\n",
        "# 1. Load image paths and labels\n",
        "DATA_DIR = \"/content/garbage_dataset\"\n",
        "IMG_SIZE = (96, 96)\n",
        "EPOCHS = 8\n",
        "\n",
        "class_names = sorted([\n",
        "    p.name for p in Path(DATA_DIR).iterdir() if p.is_dir()\n",
        "])\n",
        "class_to_id = {name: i for i, name in enumerate(class_names)}\n",
        "\n",
        "paths, labels = [], []\n",
        "\n",
        "for name in class_names:\n",
        "    for file in Path(DATA_DIR, name).glob(\"*\"):\n",
        "        if file.suffix.lower() in [\".jpg\", \".jpeg\", \".png\"]:\n",
        "            paths.append(str(file))\n",
        "            labels.append(class_to_id[name])\n",
        "\n",
        "paths = np.array(paths)\n",
        "labels = np.array(labels)\n",
        "\n",
        "# 2. Split into train, validation and test\n",
        "p_train, p_temp, y_train, y_temp = train_test_split(\n",
        "    paths, labels, test_size=0.30,\n",
        "    random_state=42, stratify=labels\n",
        ")\n",
        "\n",
        "p_val, p_test, y_val, y_test = train_test_split(\n",
        "    p_temp, y_temp, test_size=0.50,\n",
        "    random_state=42, stratify=y_temp\n",
        ")\n",
        "\n",
        "# Image loading pipeline\n",
        "def load_image(path, label):\n",
        "    image = tf.io.read_file(path)\n",
        "    image = tf.io.decode_image(\n",
        "        image, channels=3, expand_animations=False\n",
        "    )\n",
        "    image.set_shape([None, None, 3])\n",
        "    image = tf.image.resize(image, IMG_SIZE)\n",
        "    image = tf.cast(image, tf.float32) / 255.0\n",
        "    return image, label\n",
        "\n",
        "def make_dataset(paths, labels, batch_size, training=False):\n",
        "    ds = tf.data.Dataset.from_tensor_slices((paths, labels))\n",
        "    ds = ds.map(load_image, num_parallel_calls=tf.data.AUTOTUNE)\n",
        "    if training:\n",
        "        ds = ds.shuffle(1000, seed=42)\n",
        "    return ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)\n",
        "\n",
        "# 3. CNN model creation\n",
        "def create_cnn(depth, kernel, filters, pooling, batch_norm, lr):\n",
        "    model = tf.keras.Sequential()\n",
        "    model.add(tf.keras.layers.Input(shape=(96, 96, 3)))\n",
        "\n",
        "    for i in range(depth):\n",
        "        count = filters * (2 ** i)\n",
        "        model.add(tf.keras.layers.Conv2D(\n",
        "            count, kernel, padding='same', activation=None\n",
        "        ))\n",
        "\n",
        "        if batch_norm:\n",
        "            model.add(tf.keras.layers.BatchNormalization())\n",
        "\n",
        "        model.add(tf.keras.layers.Activation('relu'))\n",
        "\n",
        "        if pooling == 'max':\n",
        "            model.add(tf.keras.layers.MaxPooling2D(2))\n",
        "        else:\n",
        "            model.add(tf.keras.layers.AveragePooling2D(2))\n",
        "\n",
        "    model.add(tf.keras.layers.GlobalAveragePooling2D())\n",
        "    model.add(tf.keras.layers.Dense(128, activation='relu'))\n",
        "    model.add(tf.keras.layers.Dense(\n",
        "        len(class_names), activation='softmax'\n",
        "    ))\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=lr),\n",
        "        loss='sparse_categorical_crossentropy',\n",
        "        metrics=['accuracy']\n",
        "    )\n",
        "    return model\n",
        "\n",
        "# 4. Generate hyperparameter configurations\n",
        "grid = list(ParameterGrid({\n",
        "    'depth': [2, 3, 4],\n",
        "    'kernel': [3, 5],\n",
        "    'filters': [16, 32],\n",
        "    'pooling': ['max', 'avg'],\n",
        "    'batch_norm': [False, True],\n",
        "    'lr': [0.001, 0.0003],\n",
        "    'batch_size': [32, 64]\n",
        "}))\n",
        "\n",
        "# Select 24 reproducible configurations from the full grid\n",
        "rng = np.random.default_rng(42)\n",
        "selected = rng.choice(len(grid), size=24, replace=False)\n",
        "configs = [grid[i] for i in selected]\n",
        "\n",
        "# 5. Train and evaluate each configuration\n",
        "results = []\n",
        "\n",
        "for number, cfg in enumerate(configs, 1):\n",
        "    print(f\"\\nConfiguration {number}/24:\", cfg)\n",
        "\n",
        "    train_ds = make_dataset(\n",
        "        p_train, y_train, cfg['batch_size'], training=True\n",
        "    )\n",
        "    val_ds = make_dataset(p_val, y_val, cfg['batch_size'])\n",
        "    test_ds = make_dataset(p_test, y_test, cfg['batch_size'])\n",
        "\n",
        "    tf.keras.backend.clear_session()\n",
        "\n",
        "    model = create_cnn(\n",
        "        cfg['depth'], cfg['kernel'], cfg['filters'],\n",
        "        cfg['pooling'], cfg['batch_norm'], cfg['lr']\n",
        "    )\n",
        "\n",
        "    start = time.time()\n",
        "\n",
        "    history = model.fit(\n",
        "        train_ds,\n",
        "        validation_data=val_ds,\n",
        "        epochs=EPOCHS,\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    training_time = time.time() - start\n",
        "    test_loss, test_acc = model.evaluate(test_ds, verbose=0)\n",
        "\n",
        "    results.append({\n",
        "        **cfg,\n",
        "        'Test Accuracy': test_acc,\n",
        "        'Parameters': model.count_params(),\n",
        "        'Training Time (sec)': training_time\n",
        "    })\n",
        "\n",
        "# 6. Display comparison table\n",
        "result_df = pd.DataFrame(results)\n",
        "result_df = result_df.sort_values(\n",
        "    'Test Accuracy', ascending=False\n",
        ")\n",
        "\n",
        "print(\"\\nCNN HYPERPARAMETER COMPARISON\")\n",
        "print(result_df.round(4).to_string(index=False))\n",
        "\n",
        "# 7. Plot accuracy comparison\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.bar(range(len(result_df)), result_df['Test Accuracy'])\n",
        "plt.xlabel('Configuration (ranked)')\n",
        "plt.ylabel('Test Accuracy')\n",
        "plt.title('CNN Test Accuracy Comparison')\n",
        "plt.show()\n",
        "\n",
        "# 8. Compare model size and training time\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.scatter(\n",
        "    result_df['Parameters'],\n",
        "    result_df['Test Accuracy']\n",
        ")\n",
        "plt.xlabel('Number of Parameters')\n",
        "plt.ylabel('Test Accuracy')\n",
        "plt.title('Accuracy vs Model Size')\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.scatter(\n",
        "    result_df['Training Time (sec)'],\n",
        "    result_df['Test Accuracy']\n",
        ")\n",
        "plt.xlabel('Training Time (seconds)')\n",
        "plt.ylabel('Test Accuracy')\n",
        "plt.title('Accuracy vs Training Time')\n",
        "plt.show()\n",
        "\n",
        "# 9. Best configuration\n",
        "best = result_df.iloc[0]\n",
        "print(\"\\nBEST CONFIGURATION\")\n",
        "print(best)\n"
      ]
    },
