        "15#\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import os\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "\n",
        "# 1. Load stock price data (generate synthetic stock price data if file is missing)\n",
        "file_path = '/content/stock_prices.csv'\n",
        "if not os.path.exists(file_path):\n",
        "    print(f\"File {file_path} not found. Creating a realistic synthetic stock price dataset...\")\n",
        "    np.random.seed(42)\n",
        "    # Generate 500 days of synthetic stock data using a random walk with drift\n",
        "    dates = pd.date_range(start=\"2022-01-01\", periods=500, freq=\"D\")\n",
        "    price = 100.0\n",
        "    prices_list = []\n",
        "    for _ in range(500):\n",
        "        price += np.random.normal(0.1, 1.5)  # Drift of 0.1, volatility of 1.5\n",
        "        prices_list.append(max(10.0, price))\n",
        "\n",
        "    df_synthetic = pd.DataFrame({\n",
        "        'Date': dates,\n",
        "        'Close': prices_list\n",
        "    })\n",
        "    df_synthetic.to_csv(file_path, index=False)\n",
        "    print(f\"Successfully saved synthetic stock dataset to {file_path}.\")\n",
        "\n",
        "df = pd.read_csv(file_path)\n",
        "\n",
        "prices = pd.to_numeric(df['Close'], errors='coerce')\n",
        "prices = prices.interpolate().ffill().bfill().values.reshape(-1, 1)\n",
        "\n",
        "# Chronological split and train-only scaling\n",
        "split = int(len(prices) * 0.8)\n",
        "\n",
        "scaler = MinMaxScaler()\n",
        "train_scaled = scaler.fit_transform(prices[:split])\n",
        "all_scaled = scaler.transform(prices)\n",
        "\n",
        "# 2. Function to create sequences\n",
        "def create_sequences(data, length):\n",
        "    X, y = [], []\n",
        "    for i in range(length, len(data)):\n",
        "        X.append(data[i-length:i])\n",
        "        y.append(data[i])\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "sequence_lengths = [10, 50, 100]\n",
        "activations = ['tanh', 'relu']\n",
        "\n",
        "gradient_results = {}\n",
        "\n",
        "# 3. Compare sequence lengths and activations\n",
        "for activation in activations:\n",
        "    for seq_len in sequence_lengths:\n",
        "\n",
        "        X, y = create_sequences(all_scaled, seq_len)\n",
        "\n",
        "        # Chronological train-test split\n",
        "        train_end = split - seq_len\n",
        "        X_train, y_train = X[:train_end], y[:train_end]\n",
        "        X_test, y_test = X[train_end:], y[train_end:]\n",
        "\n",
        "        # 4. Build and train SimpleRNN\n",
        "        rnn = tf.keras.layers.SimpleRNN(\n",
        "            16, activation=activation, return_sequences=True\n",
        "        )\n",
        "        output = tf.keras.layers.Dense(1)\n",
        "\n",
        "        inputs = tf.keras.Input(shape=(seq_len, 1))\n",
        "        hidden = rnn(inputs)\n",
        "        predictions = output(hidden[:, -1, :])\n",
        "\n",
        "        model = tf.keras.Model(inputs, predictions)\n",
        "        model.compile(optimizer='adam', loss='mse')\n",
        "\n",
        "        model.fit(\n",
        "            X_train, y_train,\n",
        "            epochs=5, batch_size=32,\n",
        "            shuffle=False, verbose=0\n",
        "        )\n",
        "\n",
        "        # 5. Extract trained RNN weights\n",
        "        Wxh, Whh, bias = rnn.get_weights()\n",
        "        Wy, by = output.get_weights()\n",
        "\n",
        "        # Use one test sequence to trace gradients\n",
        "        sample = tf.constant(X_test[:1], dtype=tf.float32)\n",
        "        target = tf.constant(y_test[:1], dtype=tf.float32)\n",
        "\n",
        "        # 6. Manually unfold RNN and calculate gradients\n",
        "        with tf.GradientTape() as tape:\n",
        "            h = tf.zeros((1, 16), dtype=tf.float32)\n",
        "            states = []\n",
        "\n",
        "            for t in range(seq_len):\n",
        "                x_t = sample[:, t, :]\n",
        "                h = tf.matmul(x_t, Wxh) + tf.matmul(h, Whh) + bias\n",
        "\n",
        "                if activation == 'tanh':\n",
        "                    h = tf.math.tanh(h)\n",
        "                else:\n",
        "                    h = tf.nn.relu(h)\n",
        "\n",
        "                states.append(h)\n",
        "\n",
        "            prediction = tf.matmul(h, Wy) + by\n",
        "            loss = tf.reduce_mean(tf.square(target - prediction))\n",
        "\n",
        "        gradients = tape.gradient(loss, states)\n",
        "\n",
        "        # Gradient norm at each time step\n",
        "        norms = [\n",
        "            float(tf.norm(g).numpy()) if g is not None else 0.0\n",
        "            for g in gradients\n",
        "        ]\n",
        "\n",
        "        gradient_results[(activation, seq_len)] = norms\n",
        "\n",
        "        print(\n",
        "            activation, seq_len,\n",
        "            \"Initial gradient:\", norms[0],\n",
        "            \"Final gradient:\", norms[-1]\n",
        "        )\n",
        "\n",
        "# 7. Plot gradient norms\n",
        "fig, axes = plt.subplots(2, 1, figsize=(10, 9))\n",
        "\n",
        "for i, activation in enumerate(activations):\n",
        "    for seq_len in sequence_lengths:\n",
        "        norms = gradient_results[(activation, seq_len)]\n",
        "\n",
        "        axes[i].plot(\n",
        "            range(1, seq_len + 1),\n",
        "            np.maximum(norms, 1e-12),\n",
        "            label=f'{seq_len} days'\n",
        "        )\n",
        "\n",
        "    axes[i].set_yscale('log')\n",
        "    axes[i].set_xlabel('Time Step')\n",
        "    axes[i].set_ylabel('Gradient Norm (log scale)')\n",
        "    axes[i].set_title(f'BPTT Gradient Analysis - {activation}')\n",
        "    axes[i].legend()\n",
        "    axes[i].grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
