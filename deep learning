        "\n",
        "plt.bar(['DBN', 'Random Network'],\n",
        "        [acc_dbn*100, acc_base*100])\n",
        "plt.ylabel(\"Test Accuracy (%)\")\n",
        "plt.title(\"DBN vs Random Initialization\")\n",
        "plt.show()\n",
        "\n",
        "# 2-D representation using PCA by forward-passing explicitly\n",
        "# To avoid the symbolic input error, we build a new feature model using Functional API style\n",
        "inputs = tf.keras.Input(shape=(784,))\n",
        "x = dbn.layers[0](inputs)\n",
        "features_out = dbn.layers[1](x)\n",
        "features_model = tf.keras.Model(inputs=inputs, outputs=features_out)\n",
        "\n",
        "features = features_model.predict(T[:1000], verbose=0)\n",
        "\n",
        "pca = PCA(n_components=2)\n",
        "Z = pca.fit_transform(features)\n",
