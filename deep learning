        "        with tf.GradientTape() as tape:\n",
        "            pred = model(xb, training=True)\n",
        "\n",
        "            loss = tf.reduce_mean(\n",
        "                tf.keras.losses.sparse_categorical_crossentropy(\n",
        "                    yb, pred, from_logits=True\n",
        "                )\n",
        "            )\n",
        "\n",
        "        grads = tape.gradient(loss, model.trainable_variables)\n",
        "\n",
        "        # Calculate gradient norm\n",
        "        norm = tf.linalg.global_norm(grads)\n",
        "\n",
        "        losses.append(float(loss.numpy()))\n",
        "        norms.append(float(norm.numpy()))\n",
        "\n",
        "        # Stop if loss becomes invalid\n",
        "        if not np.isfinite(losses[-1]):\n",
        "            break\n",
        "\n",
        "        # Global norm clipping\n",
        "        if method == \"clipnorm\":\n",
        "            grads, _ = tf.clip_by_global_norm(grads, limit)\n",
        "\n",
        "        # Value clipping (supports sparse gradients)\n",
        "        elif method == \"clipvalue\":\n",
        "            clipped_grads = []\n",
        "\n",
        "            for g in grads:\n",
        "                if isinstance(g, tf.IndexedSlices):\n",
        "                    g = tf.IndexedSlices(\n",
        "                        tf.clip_by_value(g.values, -limit, limit),\n",
        "                        g.indices,\n",
        "                        g.dense_shape\n",
        "                    )\n",
        "                else:\n",
        "                    g = tf.clip_by_value(g, -limit, limit)\n",
        "\n",
        "                clipped_grads.append(g)\n",
        "\n",
        "            grads = clipped_grads\n",
        "\n",
        "        opt.apply_gradients(zip(grads, model.trainable_variables))\n",
        "\n",
        "    return losses, norms\n",
        "\n",
        "\n",
        "# Different clipping methods\n",
        "settings = {\n",
        "    \"No clipping\": (\"none\", None),\n",
