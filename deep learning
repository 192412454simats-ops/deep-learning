        "import matplotlib.pyplot as plt\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# Generate synthetic sensor data\n",
        "np.random.seed(42)\n",
        "X = np.random.randn(200, 5) @ np.random.randn(5, 3) + np.random.randn(200, 3)*0.2\n",
        "\n",
        "# Add Gaussian noise\n",
        "X += np.random.normal(0, 0.3, X.shape)\n",
        "\n",
        "# Standardize data\n",
        "X = StandardScaler().fit_transform(X)\n",
        "\n",
        "# Fit PPCA using PCA\n",
        "pca = PCA(n_components=3)\n",
        "Z = pca.fit_transform(X)\n",
        "\n",
        "# Estimate noise variance\n",
        "print(\"Noise Variance:\", pca.noise_variance_)\n",
        "\n",
        "# Reconstruction and error\n",
        "errors = []\n",
        "for k in range(1, 4):\n",
        "    model = PCA(n_components=k)\n",
        "    z = model.fit_transform(X)\n",
        "    recon = model.inverse_transform(z)\n",
        "    errors.append(np.mean((X-recon)**2))\n",
        "\n",
        "# Plot reconstruction error\n",
        "plt.plot(range(1, 4), errors, marker='o')\n",
        "plt.xlabel(\"Components\")\n",
        "plt.ylabel(\"Reconstruction Error\")\n",
        "plt.show()\n",
        "\n",
        "# Generate new synthetic samples\n",
        "samples = pca.mean_ + np.random.randn(5, 3) @ pca.components_\n",
        "print(\"Generated Samples:\\n\", samples)"
