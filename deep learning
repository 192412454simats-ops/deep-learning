        "plt.show()\n",
        "\n",
        "# -------- DCGAN --------\n",
        "G=tf.keras.Sequential([\n",
        "    layers.Input((100,)),layers.Dense(7*7*128),\n",
        "    layers.Reshape((7,7,128)),layers.BatchNormalization(),\n",
        "    layers.ReLU(),\n",
        "    layers.Conv2DTranspose(64,4,2,'same'),\n",
        "    layers.BatchNormalization(),layers.ReLU(),\n",
        "    layers.Conv2DTranspose(1,4,2,'same',activation='tanh')\n",
        "])\n",
        "\n",
        "D=tf.keras.Sequential([\n",
        "    layers.Input((28,28,1)),\n",
        "    layers.Conv2D(64,4,2,'same'),\n",
        "    layers.LeakyReLU(.2),layers.Flatten(),layers.Dense(1)\n",
        "])\n",
        "\n",
        "data=X*2-1\n",
        "go=tf.keras.optimizers.Adam(.0002,beta_1=.5)\n",
        "do=tf.keras.optimizers.Adam(.0002,beta_1=.5)\n",
        "loss_fn=tf.keras.losses.BinaryCrossentropy(from_logits=True)\n",
        "gl,dl=[],[]\n",
        "seed=tf.random.normal((10,100))\n",
        "\n",
        "for ep in range(5):\n",
        "    for i in range(0,len(data),128):\n",
        "        real=data[i:i+128]\n",
        "        noise=tf.random.normal((len(real),100))\n",
        "\n",
        "        with tf.GradientTape() as dt, tf.GradientTape() as gt:\n",
        "            fake=G(noise,training=True)\n",
        "            ro,fo=D(real,training=True),D(fake,training=True)\n",
        "            dloss=(loss_fn(tf.ones_like(ro),ro)+\n",
        "                   loss_fn(tf.zeros_like(fo),fo))\n",
        "            gloss=loss_fn(tf.ones_like(fo),fo)\n",
        "\n",
        "        do.apply_gradients(zip(dt.gradient(dloss,D.trainable_variables),\n",
        "                               D.trainable_variables))\n",
        "        go.apply_gradients(zip(gt.gradient(gloss,G.trainable_variables),\n",
        "                               G.trainable_variables))\n",
        "\n",
        "    dl.append(float(dloss))\n",
        "    gl.append(float(gloss))\n",
        "    print(\"Epoch\",ep+1,\"G Loss:\",round(gl[-1],4),\n",
        "          \"D Loss:\",round(dl[-1],4))\n",
        "\n",
        "    generated=G(seed,training=False)\n",
        "    plt.figure(figsize=(6,2))\n",
        "    for j in range(10):\n",
        "        plt.subplot(2,5,j+1)\n",
        "        plt.imshow((generated[j,:,:,0]+1)/2,cmap='gray')\n",
        "        plt.axis('off')\n",
        "    plt.savefig(f\"GAN_epoch_{ep+1}.png\")\n",
        "    plt.close()\n",
        "\n",
        "# Loss curves\n",
        "plt.plot(gl,label='Generator')\n",
        "plt.plot(dl,label='Discriminator')\n",
        "plt.xlabel('Epoch')\n",
        "plt.ylabel('Loss')\n",
        "plt.title('DCGAN Loss')\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "print(\"VAE and GAN completed successfully!\")"
