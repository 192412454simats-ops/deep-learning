        "        elif cell == 'LSTM':\n",
        "            model.add(tf.keras.layers.LSTM(units))\n",
        "        else:\n",
        "            model.add(tf.keras.layers.GRU(units))\n",
        "\n",
        "        if i == 0 and hp.get('layers') > 1:\n",
