        "7#\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# 1. Generate loan dataset (100 applications)\n",
        "X = np.random.rand(100, 2)\n",
        "y = ((X[:,0] > 0.5) & (X[:,1] > 0.4)).astype(int)\n",
        "\n",
        "# Perceptron functions\n",
        "def step(z):\n",
        "    return (z >= 0).astype(int)\n",
        "\n",
        "def sigmoid(z):\n",
        "    return 1/(1+np.exp(-z))\n",
        "\n",
        "def relu(z):\n",
        "    return np.maximum(0,z)\n",
        "\n",
        "# 2. Train perceptron\n",
        "w = np.zeros(2)\n",
        "b = 0\n",
        "lr = 0.1\n",
        "errors = []\n",
        "\n",
        "for epoch in range(20):\n",
        "    error = 0\n",
        "    for xi, target in zip(X,y):\n",
        "        z = np.dot(xi,w)+b\n",
        "        pred = step(z)\n",
        "        update = lr*(target-pred)\n",
        "        w += update*xi\n",
        "        b += update\n",
        "        error += abs(update)\n",
        "    errors.append(error)\n",
        "    print(\"Epoch:\", epoch+1, \"Weights:\", w)\n",
        "\n",
        "# 3. Decision boundary\n",
        "plt.scatter(X[:,0], X[:,1], c=y, cmap='bwr')\n",
        "xline = np.linspace(0,1,100)\n",
        "if abs(w[1]) > 1e-8:\n",
        "    yline = -(w[0]*xline+b)/w[1]\n",
        "    plt.plot(xline,yline,'k')\n",
        "plt.xlabel(\"Credit Score\")\n",
        "plt.ylabel(\"Income-to-Debt Ratio\")\n",
        "plt.title(\"Loan Approval Decision Boundary\")\n",
        "plt.show()\n",
        "\n",
        "# 4. XOR dataset\n",
        "XOR = np.array([[0,0],[0,1],[1,0],[1,1]])\n",
        "YOR = np.array([0,1,1,0])\n",
        "\n",
        "w = np.zeros(2)\n",
        "b = 0\n",
        "\n",
        "for epoch in range(20):\n",
        "    for xi,target in zip(XOR,YOR):\n",
        "        pred = step(np.dot(xi,w)+b)\n",
        "        update = 0.1*(target-pred)\n",
        "        w += update*xi\n",
        "        b += update\n",
        "\n",
        "predictions = step(XOR @ w+b)\n",
        "print(\"XOR Predictions:\", predictions)\n",
        "print(\"Actual:\", YOR)\n",
        "print(\"XOR Accuracy:\", np.mean(predictions==YOR)*100,\"%\")\n",
