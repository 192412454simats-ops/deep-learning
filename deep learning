        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Reconstruction Error\")\n",
        "plt.title(\"CD and PCD Comparison\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# Approximate pseudo-log-likelihood using one-bit flip\n",
        "def pll(W, a, b, data):\n",
        "    scores = []\n",
        "    for v in data[:100]:\n",
        "        i = np.random.randint(nv)\n",
        "        v_flip = v.copy()\n",
        "        v_flip[i] = 1 - v_flip[i]\n",
        "\n",
        "        def free_energy(x):\n",
        "            return -x @ a - np.sum(np.logaddexp(0, x @ W + b))\n",
        "\n",
        "        scores.append(-np.logaddexp(0, free_energy(v)-free_energy(v_flip)))\n",
        "    return np.mean(scores)\n",
        "\n",
        "print(\"\\nPseudo-log-likelihood:\")\n",
        "for name, k, pcd in [\n",
        "    ('CD-1',1,False), ('CD-5',5,False),\n",
        "    ('CD-10',10,False), ('PCD',1,True)\n",
        "]:\n",
        "    W, a, b, _, _ = train_rbm(k, pcd)\n",
