        "import numpy as np\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# Load MNIST\n",
        "(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()\n",
        "X = (x_train.reshape(-1, 784) / 255.0 > 0.5).astype(float)\n",
        "T = x_test.reshape(-1, 784) / 255.0\n",
        "Y = tf.keras.utils.to_categorical(y_train[:1000], 10)\n",
        "XT = tf.keras.utils.to_categorical(y_test, 10)\n",
        "\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "\n",
        "# RBM training using CD-1\n",
        "def train_rbm(data, nv, nh, epochs=3):\n",
        "    W = np.random.normal(0, 0.01, (nv, nh))\n",
        "    a, b = np.zeros(nv), np.zeros(nh)\n",
        "\n",
        "    for ep in range(epochs):\n",
        "        np.random.shuffle(data)\n",
        "        for i in range(0, len(data), 100):\n",
        "            v0 = data[i:i+100]\n",
        "            ph0 = 1/(1+np.exp(-np.clip(v0@W+b, -50, 50)))\n",
        "            h = (np.random.rand(*ph0.shape) < ph0).astype(float)\n",
        "            pv = 1/(1+np.exp(-np.clip(h@W.T+a, -50, 50)))\n",
        "            v1 = (np.random.rand(*pv.shape) < pv).astype(float)\n",
        "            ph1 = 1/(1+np.exp(-np.clip(v1@W+b, -50, 50)))\n",
        "\n",
        "            W += 0.01*(v0.T@ph0-v1.T@ph1)/len(v0)\n",
        "            a += 0.01*np.mean(v0-v1, axis=0)\n",
        "            b += 0.01*np.mean(ph0-ph1, axis=0)\n",
        "\n",
        "        print(\"RBM Epoch:\", ep+1)\n",
        "\n",
        "    return W, a, b\n",
        "\n",
        "# Greedy layer-wise pretraining\n",
        "W1, a1, b1 = train_rbm(X[:10000], 784, 500)\n",
        "H1 = 1/(1+np.exp(-np.clip(X[:10000]@W1+b1, -50, 50)))\n",
        "\n",
        "W2, a2, b2 = train_rbm(H1, 500, 250)\n",
        "\n",
        "# Visualise first-layer filters\n",
        "plt.figure(figsize=(8,8))\n",
        "for i in range(25):\n",
        "    plt.subplot(5,5,i+1)\n",
        "    plt.imshow(W1[:,i].reshape(28,28), cmap='gray')\n",
        "    plt.axis('off')\n",
        "plt.suptitle(\"First RBM Learned Filters\")\n",
        "plt.show()\n",
        "\n",
        "# DBN classifier with pretrained weights\n",
        "def build_model(pretrained=False):\n",
        "    model = tf.keras.Sequential([\n",
        "        tf.keras.layers.Input(shape=(784,)),\n",
        "        tf.keras.layers.Dense(500, activation='sigmoid', name='dense_1'),\n",
        "        tf.keras.layers.Dense(250, activation='sigmoid', name='dense_2'),\n",
        "        tf.keras.layers.Dense(10, activation='softmax', name='dense_out')\n",
        "    ])\n",
        "\n",
        "    if pretrained:\n",
        "        model.layers[0].set_weights([W1, b1])\n",
        "        model.layers[1].set_weights([W2, b2])\n",
        "\n",
        "    model.compile(optimizer='adam',\n",
        "                  loss='categorical_crossentropy',\n",
        "                  metrics=['accuracy'])\n",
        "    return model\n",
        "\n",
        "# Fine-tune using only 1000 labelled samples\n",
        "dbn = build_model(True)\n",
        "\n",
        "history_dbn = dbn.fit(X[:1000], Y, epochs=10,\n",
        "                      batch_size=32, validation_split=0.2,\n",
        "                      verbose=0)\n",
        "\n",
        "# Train same network from random initialization\n",
        "baseline = build_model(False)\n",
        "\n",
        "history_base = baseline.fit(X[:1000], Y, epochs=10,\n",
        "                             batch_size=32, validation_split=0.2,\n",
        "                             verbose=0)\n",
        "\n",
        "# Compare test accuracy\n",
        "acc_dbn = dbn.evaluate(T, XT, verbose=0)[1]\n",
        "acc_base = baseline.evaluate(T, XT, verbose=0)[1]\n",
        "\n",
        "print(\"DBN Test Accuracy:\", round(acc_dbn*100, 2), \"%\")\n",
