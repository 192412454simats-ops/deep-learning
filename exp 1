      "source": [
        "# Task 4: Dense Layer Simulation (y = Wx + b) for one customer\n",
        "\n",
        "# Let's take the first customer vector x (shape: 5,)\n",
        "x = customer_genre[0]\n",
        "\n",
        "# Define weight matrix W (shape: 3 units x 5 features) and bias b (shape: 3,)\n",
        "W = np.random.normal(0, 0.1, size=(3, 5))\n",
        "b = np.random.normal(0, 0.1, size=(3,))\n",
        "\n",
        "# Manual Dense Layer computation\n",
        "y = np.dot(W, x) + b\n",
        "\n",
        "print(\"Customer Profile vector x:\", x)\n",
        "print(\"Dense Layer Output y:\", y.round(3))"
      ],
