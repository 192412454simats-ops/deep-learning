      "source": [
        "# Task 3: Compute Cosine Similarity between Customers\n",
        "\n",
        "def cosine_similarity_matrix(matrix):\n",
        "    # Normalize rows to unit vectors\n",
        "    norms = np.linalg.norm(matrix, axis=1, keepdims=True)\n",
        "    normalized = matrix / norms\n",
        "    # Dot product of normalized vectors gives cosine similarity\n",
        "    similarity = np.dot(normalized, normalized.T)\n",
        "    return similarity\n",
        "\n",
        "sim_matrix = cosine_similarity_matrix(customer_genre)\n",
        "print(\"Customer Similarity Matrix (6x6):\")\n",
        "print(sim_matrix.round(3))\n",
        "\n",
        "# Find the two most similar (distinct) customers\n",
        "# Set diagonal to zero to ignore self-similarity\n",
        "temp_sim = sim_matrix.copy()\n",
        "np.fill_diagonal(temp_sim, 0)\n",
        "\n",
        "idx = np.unravel_index(np.argmax(temp_sim), temp_sim.shape)\n",
        "customer_a, customer_b = idx\n",
        "print(f\"\\nThe two most similar customers are Customer {customer_a} and Customer {customer_b} with a similarity of {temp_sim[idx]:.3f}.\")"
      ],
