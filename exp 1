        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Set random seed for reproducibility\n",
        "np.random.seed(42)\n",
        "\n",
        "# Task 1: Build Matrices\n",
        "# Customer-Genre Matrix (6 customers x 5 genres)\n",
        "# Simulating ratings on a scale of 1 to 5\n",
        "customer_genre = np.random.randint(1, 6, size=(6, 5))\n",
        "\n",
        "# Genre-Book Matrix (5 genres x 4 books)\n",
        "# Simulating genre weight representations for books\n",
        "genre_book = np.random.uniform(0.1, 1.0, size=(5, 4))\n",
        "\n",
        "print(\"Customer-Genre Matrix (6x5):\")\n",
        "print(customer_genre)\n",
        "print(\"\\nGenre-Book Matrix (5x4):\")\n",
        "print(genre_book.round(2))"
